<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record id="mail_template_export_group" model="mail.template">
    <field name="name">Export Group - Daily Reporting</field>
    <field name="subject">Daily Export Report - {{ object.company_id.name }}</field>
    <field name="model_id" ref="model_export_async_schedule_group" />
    <field name="auto_delete" eval="False" />
    <field name="body_html" type="html">
      <p>Dear Team,</p>
      <p>Please find attached the daily export reports for <strong>
        <t t-out="object.company_id.name" />
      </strong>.</p>
      <p>This email contains the following exports:</p>
      <ul>
        <t t-foreach="object.export_schedule_ids" t-as="schedule">
          <li>
            <t t-out="schedule.ir_export_id.name or schedule.model_id.name" />
          </li>
        </t>
      </ul>
      <br />
      <p>
        <span
                    style="color: #808080;"
                >This is an automated message, please do not reply.</span>
      </p>
    </field>
  </record>
</odoo>
